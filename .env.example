# Applicatie
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
METRICS_ENABLED=true
APP_BASE_PATH=/gsplayer

# Spotify (worden door GitHub Actions/Runtime gezet)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Security
# 32 bytes base64, bijvoorbeeld: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Cache
CACHE_BACKEND=memory
CACHE_LRU_MAX_ENTRIES=2000
CACHE_REDIS_URL=
CACHE_REDIS_PREFIX=gsplayer:spotify:

# Timeouts & retries
SPOTIFY_REQUEST_TIMEOUT_MS=8000
SPOTIFY_MAX_RETRIES=4
SPOTIFY_RETRY_BASE_DELAY_MS=250
SPOTIFY_RETRY_MAX_DELAY_MS=4000
SPOTIFY_RETRY_JITTER_RATIO=30

# Cache TTLs (ms)
CACHE_TTL_ME_MS=60000
CACHE_TTL_PLAYLISTS_MS=120000
CACHE_TTL_TRACK_MS=43200000
CACHE_TTL_ARTIST_MS=43200000
CACHE_TTL_SEARCH_MS=60000

CACHE_MAX_STALE_ME_MS=30000
CACHE_MAX_STALE_PLAYLISTS_MS=60000
CACHE_MAX_STALE_TRACK_MS=21600000
CACHE_MAX_STALE_ARTIST_MS=21600000
CACHE_MAX_STALE_SEARCH_MS=30000

# Container image (voor docker-compose op de Pi)
GSPLAYER_IMAGE=
